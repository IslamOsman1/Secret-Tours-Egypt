{
  "services": {
    "web": {
      "root": "client",
      "entrypoint": "package.json"
    },
    "api": {
      "root": "server",
      "entrypoint": "src/index.js",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api",
        "path": "/api/$1"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "web",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/logo.png",
      "destination": {
        "service": "web",
        "path": "/logo.png"
      }
    },
    {
      "source": "/image.png",
      "destination": {
        "service": "web",
        "path": "/image.png"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web",
        "path": "/index.html"
      }
    }
  ]
}
