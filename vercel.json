{
  "services": {
    "web": {
      "root": "client",
      "entrypoint": "package.json"
    },
    "api": {
      "root": "server",
      "entrypoint": "src/index.js",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
